# Copy this file to ".env" and paste your real key(s) — no quotes, no spaces.
# Get keys at: https://console.cloud.google.com/  (enable "YouTube Data API v3")
#
# The engine assigns ONE KEY PER SEED (seed 1 -> key 1, seed 2 -> key 2, ...),
# so a greedy first seed can never consume a later seed's budget. If a seed
# exhausts its own key it falls back to any still-unused key.
#
# The LAST TWO keys are reserved for cheap operations (topic grading), so a
# big niche build can never leave you unable to grade a topic.
#
# One key works fine to start; add more as you scale up seeds.
YOUTUBE_API_KEY_1=YOUR_FIRST_KEY_HERE
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
YOUTUBE_API_KEY_4=
YOUTUBE_API_KEY_5=
YOUTUBE_API_KEY_6=
YOUTUBE_API_KEY_7=
# (Plain YOUTUBE_API_KEY=... also works and is treated as key 1.)
